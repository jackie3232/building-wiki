{
  "meta": {
    "type": "siheyuan",
    "desc": "北京四合院类型图谱（WHAT·知识）：定义构成角色、组合拓扑、尺度模数参数槽、等级与材质。零坐标、无绝对米数。实例图谱继承本结构、受 siheyuan.rules 约束、用 dict.json 的 key 作词表。",
    "dictRef": "dict.json",
    "rulesRef": "siheyuan.rules",
    "zeroCoord": true
  },
  "site": {
    "type": "siheyuan",
    "desc": "一座四合院实例的顶层",
    "children": {
      "courtyards": {
        "relation": "xulie",
        "ref": "xulie",
        "countParam": "jin",
        "refParam": "jin",
        "desc": "沿中轴南北序列排布的 jin 个院落",
        "childType": "courtyard"
      }
    }
  },
  "courtyard": {
    "refRole": "tingyuan",
    "desc": "基本空间单元：由房屋围合出的露天院落",
    "center": {
      "role": "tingyuan",
      "ref": "tingyuan",
      "desc": "院落中心（露天）"
    },
    "gate": {
      "role": "chuihuamen",
      "ref": "chuihuamen",
      "boundary": "between_sequence_1_and_2",
      "cond": "jin>=2",
      "desc": "仅一进→二进分界（卡子墙正中、中轴线）设一道垂花门；其余院落边界不设独立门楼（二进→三进经正房明间穿堂）"
    },
    "peripheral": [
      {
        "role": "youlang",
        "ref": "youlang",
        "desc": "游廊连接各屋（可选）。【当前不启用】几何层各进 peripheral 未声明 youlang，留待加细节阶段确定抄手游廊形制与归属后再恢复"
      },
      {
        "role": "yingbi",
        "ref": "yingbi",
        "desc": "门内影壁（可选）：正对宅门、立于门内侧，归宅门所在之院（第一进）"
      },
      {
        "role": "erfang",
        "ref": "erfang",
        "attachTo": "zhengfang",
        "cond": "optional",
        "desc": "耳房接正房两侧（可选）"
      },
      {
        "role": "houzhaofang",
        "ref": "houzhaofang",
        "cond": "jin>=3",
        "desc": "后罩房位于正房之后（多进时出现）"
      }
    ],
    "ring": {
      "relation": "weihe",
      "ref": "weihe",
      "desc": "院落连续围墙基底（boundarySegmentRealization 院墙环分段实现）：每院先有一道完整四侧墙环（纯围墙基线）；叠加建筑后，其贴边界的后檐墙分段实现（替换）对应围墙段；建筑间空隙由补墙/游廊填。每侧墙基底默认存在（provider=null 即独立院墙），该侧若有建筑后檐墙则声明 provider 分段实现该侧。",
      "sides": {
        "bei": {
          "wall": "yuanqiang",
          "candidateProvider": "zhengfang",
          "ref": "zhengfang",
          "desc": "北墙基底；默认由正房/后罩房后檐墙提供，无北房则为独立院墙"
        },
        "nan": {
          "wall": "yuanqiang",
          "candidateProvider": "daozuofang",
          "ref": "daozuofang",
          "desc": "南墙基底；默认由倒座房后檐墙提供，无倒座则为独立院墙"
        },
        "dong": {
          "wall": "yuanqiang",
          "candidateProvider": "xiangfang",
          "ref": "xiangfang",
          "desc": "东墙基底；默认由东厢房后檐墙提供，无东厢则为独立院墙"
        },
        "xi": {
          "wall": "yuanqiang",
          "candidateProvider": "xiangfang",
          "ref": "xiangfang",
          "desc": "西墙基底；默认由西厢房后檐墙提供，无西厢则为独立院墙"
        }
      }
    }
  },
