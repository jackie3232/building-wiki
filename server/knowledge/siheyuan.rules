    },
    {
      "role": "xiangfang",
      "at": [
        "dong",
        "xi"
      ],
      "constraint": "duichen",
      "ref": [
        "dong",
        "xi",
        "duichen"
      ],
      "desc": "厢房东西对称"
    },
    {
      "role": "daozuofang",
      "at": "nan_end",
      "desc": "倒座房位于院落最南"
    },
    {
      "role": "chuihuamen",
      "between": [
        "一进",
        "二进"
      ],
      "at": "kaziqiang_center",
      "constraint": "zhongzhou",
      "ref": [
        "chuihuamen",
        "kaziqiang",
        "zhongzhou"
      ],
      "desc": "垂花门仅设于卡子墙正中、中轴线，分隔一进(外院)与二进(内院)；二进→三进不设独立门楼"
    },
    {
      "role": "houzhaofang",
      "at": "north_of_zhengfang",
      "ref": "houzhaofang",
      "desc": "后罩房位于正房之后"
    },
    {
      "role": "chuantang",
      "at": "zhengfang_mingjian",
      "when": "jin>=3",
      "ref": [
        "chuantang",
        "zhengfang",
        "mingjian"
      ],
      "desc": "三进时内院正房明间(中央开间)做穿堂，南北开门连通后院；备选为东耳房尽端夹道"
    },
    {
      "role": "zhaimen",
      "attachedTo": "daozuofang_east",
      "at": "southeast_corner",
      "ref": "zhaimen",
      "desc": "大门位于倒座房东端、院落东南角(坎宅巽门)"
    },
    {
      "role": "houmen",
      "attachedTo": "houzhaofang_west",
      "at": "northwest_corner",
      "when": "jin>=3",
      "byDefault": false,
      "trigger": "宅后临街",
      "ref": "houmen",
      "desc": "后门位于后罩房西端、院落西北角（将西北角一间空出改门道、通北胡同）。条件性——仅当宅后临街才设，默认不设：后罩房后檐墙通常不开门窗（防御），不临街时此位为实墙；用户未明确提到「宅后临街」或「开后门」时，不要声明此门（用户 2026-09-20 定）。后罩房只出现在 jin>=3 的末进，故二进及以下自然无后门。"
    }
  ],
  "usage": [
    {
      "role": "zhengfang",
      "usage": "guoting",
      "at": "erjinyuan_zhengwei",
      "when": "jin>=4",
      "ref": [
        "guoting",
        "zhengfang",
        "erjinyuan_zhengwei"
      ],
      "desc": "四进院中，第二进院的正位房作「过厅」（前堂）：前后开门、南北贯通，其北第三进院的正位房仍为正房（后寝），构成「前堂后寝」。role 不变、仅用途不同——依据快懂百科《四进院落》中轴序列原文「南房、第一进院、垂花门、第二进院、正房或过厅、第三进院、正房、第四进院、后罩房」，及汉典·国语辞典「过厅=旧式房屋中前后开门，可供人穿行通过的厅堂」。"
    }
  ],
  "sequence": {
    "ref": "xulie",
    "desc": "进沿中轴南北序列；进数↑院落往南加",
    "naming": {
      "desc": "院落名推导规则 —— 院名的唯一事实源。引擎按序求值、首个命中者胜出，代码内不得再硬编码院名映射。命名按「身份」不按「进号」：院名由该院在垂花门（二门）前后的位置与正房位置决定，不由第几进推导拼接；进号定位（第几进）、身份名定性（什么院），二者并存、互不替代。命中规则的 name 是命名字典 key，中文名一律由字典 label 给出（字典是命名权威）。",
      "rules": [
        {
          "id": "waiyuan",
          "at": 1,
          "jinGte": 2,
          "name": "waiyuan",
          "why": "分界构件：垂花门（二门）是外宅与内宅的唯一分界，其以南为外院。jin≥2 才有内外之别。"
        },
        {
          "id": "houzhaoyuan",
          "at": "last",
          "jinGte": 3,
          "name": "houzhaoyuan",
          "why": "主院唯一：主院之外，「后罩房所在的最末一进」为后罩院。一/二进无后罩房，故 jin≥3 才成立。"
        },
        {
          "id": "tingfangyuan",
          "at": 2,
          "jinGte": 4,
          "name": "tingfangyuan",
          "why": "中间进：四、五进院通常为「前堂后寝」——厅房所在进为厅房院（前堂）。据帽儿胡同 11 号五进实例：一进院（倒座）→二进院（正厅）→三进院（正房院·主院）→四进院→五进院（后罩房）。"
        },
        {
          "id": "neiyuan-main",
          "at": 3,
          "jinGte": 4,
          "name": "neiyuan",
          "why": "主院唯一：正房所在的那一进即内院（后寝），全院只有一个。前堂之北第一进即主院。"
        },
        {
          "id": "neiyuan-2jin",
          "at": 2,
          "jinEq": 2,
          "name": "neiyuan",
          "why": "二进无前堂，垂花门之后即正房所在的主院。"
        },
        {
          "id": "neiyuan-3jin",
          "at": 2,
          "jinEq": 3,
          "name": "neiyuan",
          "why": "三进无前堂，故第二进即主院。"
        },
        {
          "id": "tingyuan",
          "at": 1,
          "jinEq": 1,
          "name": "tingyuan",
          "why": "一进院不立新词：无垂花门即无内外之分，此院既是入口院也是主院，沿用空间角色 tingyuan「庭院」。"
        }
      ],
      "fallback": {
        "name": "neiyuan",
        "ordinalFrom": 2,
        "why": "其余次院属「同类多次出现」，用中文次第后缀记（内院·二 / 内院·三），不拼阿拉伯数字（禁止「内院1」）。序数 = 进号 - ordinalFrom。"
      },
      "note": "本规则只负责「第 k 进叫什么院名」。结构与通行另见：三进以上一进→二进走垂花门（chuihuamen），其后各进由上一进正房明间做穿堂（chuantang）南北贯通，末进经穿堂连通并设后门（houmen）通北胡同；四进时第二进正位房作「过厅」（见 usage 中 guoting 条）——过厅仍是 zhengfang，仅用途不同，不另立角色。厅房院与主院之间的过渡进，文献未给专名（仅以进号记，如「第三进院」），本应用不另造词；但本应用每个中间进都置正房，故「无正房的纯过渡进」这一形态尚未建模，不在本规则内。"
    }
  },
  "norms": {
    "modus": 3.3,
    "room": {
      "thickness": 0.3,
      "heightDefault": 3.3,
      "taimingOutset": 0.5,
      "desc": "房间围合墙/顶/地厚度(米)，原 ④ 常量 WALL_THICKNESS。房屋自身厚度，与院墙厚度(wall.*)语义不同故分列。heightDefault：角色未声明 height 时的回落基准。taimingOutset：台基自房屋外墙面线外扩的距离(米)——台明露出部分即为可见台座。"
    },
    "taiming": {
      "desc": "台基高(台明高，米)。**声明即生成**：某角色声明了 taiming，④ 才为它生成台基构件（对照类型图谱 structs 是否含 taiji）。依据清工部《工程做法则例》小式「台明高=柱高/5」≈0.66m；马炳坚《北京四合院建筑》「垂花门、大门台明可与正房同高但不可超越；厢房、抄手游廊、倒座房比正房低一步台阶(4寸≈0.13m)；耳房既低于正房也低于厢房」。本轮各房屋统一取 0.30m（= 展示层巡游落脚面 TOUR_STEP，保证巡游与台基自洽）；等级分化的台明（正房 0.66 / 厢房·倒座 0.53 / 后罩房 0.40）留待体素细化轮启用——VOXEL_SIZE=0.6m 下 0.40~0.70 同渲染为 1 层，无可视差异。"
    },
    "door": {
      "width": 1.6,
      "height": 2.1,
      "desc": "房门洞口宽/高(米，高自地面起)，原 ④ 常量 DOOR_WIDTH / DOOR_HEIGHT。与门体面阔(gateSpan)语义不同：门洞是墙上开的缺，门体是一栋建筑。"
    },
    "courtDepthRatio": {
      "byRole": {
        "waiyuan": 0.3,
        "tingfangyuan": 0.45,
        "neiyuan": 0.6,
        "houzhaoyuan": 0.42,
        "tingyuan": 0.6
      },
      "default": 0.45,
      "desc": "露天院落进深=面阔×ratio，按院落角色：waiyuan=外院(最浅，南北短东西长)、tingfangyuan=厅房院(前堂，居中)、neiyuan=内院主院(最大，近正方形)、houzhaoyuan=后罩院及其前的次院(居中)。一进仅 tingyuan(庭院，既入口院又是主院、无独立院名)；二进=waiyuan+neiyuan；三进=waiyuan+neiyuan+houzhaoyuan；四进及以上前堂后寝=waiyuan+tingfangyuan+neiyuan+houzhaoyuan(+次院)。neiyuan=正房所在的主院(后寝)，取最靠南的正房院但跳过作过厅(usage=guoting)的那一进——过厅是前堂不是后寝；tingfangyuan=作过厅的那一进；waiyuan=倒座所在的外院；houzhaoyuan=neiyuan 之后的院。"
    },
    "layout": {
      "xiangfang": {
        "lengthMode": "miankuo",
        "aisle": 1.5,
        "zAlign": "center",
        "desc": "厢房沿庭院方向(Z)长度取自身面阔(3间×modus≈9.9m)，居中放置在正房与倒座之间的庭院区域，南北两端各留1.5m通道，使中央庭院完整保留（不填满庭院、不与正房/倒座紧贴）"
      }
    },
    "zhengfang": {
      "miankuo": 5,
      "jinshen": 2,
      "height": 3.3,
      "taiming": 0.3,
      "desc": "正房面阔5间(1明+2次+2梢)；进深约6.5m(≈2×modus)，据《北京老城保护房屋修缮技术导则2019》正房五檩/七檩进深6.5~7m。height 暂与厢房持平(3.3)，待按等级校准——正房应最高。taiming=台明高，见 norms.taiming.desc。"
    },
    "xiangfang": {
      "miankuo": 3,
      "jinshen": 1.4,
      "height": 3.3,
      "taiming": 0.3,
      "desc": "厢房面阔3间；进深约4.5m(≈1.4×modus)，据导则厢房无廊进深4m、带廊5m。height 原 ④ 常量 WING_HEIGHT。taiming=台明高，见 norms.taiming.desc。"
    },
    "daozuofang": {
      "miankuo": 5,
      "jinshen": 1.4,
      "height": 3.3,
      "taiming": 0.3,
      "desc": "倒座房面阔约同正房；进深较浅约4.5m。height 原 ④ 常量 WING_HEIGHT。taiming=台明高，见 norms.taiming.desc。"
    },
    "houzhaofang": {
      "miankuo": 5,
      "jinshen": 1.5,
      "height": 3.3,
      "taiming": 0.3,
      "desc": "后罩房面阔约同正房；进深较浅约5m。height 原 ④ 常量 WING_HEIGHT。taiming=台明高，见 norms.taiming.desc。"
    },
    "chuihuamen": {
      "gateSpan": 3.0,
      "height": 3.6,
      "depth": 1.2,
      "desc": "垂花门面阔约一间(3.0m，比照宅门门道 gateSpan)；门楼比门道顶(3.3)略抬高至3.6；depth=门道进深(米)。"
    },
    "zhaimen": {
      "gateSpan": 3.0,
      "height": 4.2,
      "eastMargin": 0.8,
      "desc": "宅门(大门)：门道面阔 gateSpan=3.0；门楼屋顶高 height=4.2(高于普通房屋)；eastMargin=门道东缘距院墙东端留白(米)，使东南角院墙完整闭合。进深同所在倒座房，不单列。"
    },
    "houmen": {
      "gateSpan": 3.0,
      "westMargin": 0.8,
      "desc": "后门：门道面阔 gateSpan=3.0(约一间，比照宅门)；westMargin=门道西缘距院墙西端留白(米)，使西北角院墙完整闭合。与宅门的两点差异：①后门不带门楼，故不单列 height（门道高=同排后罩房高）；②位于西端而非东端。进深同所在后罩房，不单列。"
    },
    "chuantang": {
      "mingjianOpen": true,
      "desc": "正房明间(中央开间)南北双向开门，作过厅连通后院"
    },
    "peripheral": {
      "youlang": {
        "height": 2.5,
        "depth": 1.2,
        "spanRatio": 0.85,
        "colSpacing": 2.5,
        "roofThickness": 0.2,
        "desc": "游廊：height=廊顶高(米，原 ④ 常量 PERIPH_HEIGHT)；depth=廊深；spanRatio=廊长占房屋面阔比例；colSpacing=柱间距(米)；roofThickness=廊顶板厚。中轴穿堂口按 door.width 断开。"
      },
      "yingbi": {
        "height": 2.5,
        "width": 3.0,
        "depth": 0.5,
        "zOffset": 2.0,
        "xInset": 0.5,
        "desc": "影壁：height=高；width=面宽；depth=厚；zOffset=自院落南界北移距离(米)；xInset=自东界内收距离(米)。zOffset 使影壁距宅门门道轴线约 4.2m（合「距门内约丈余」），同时在影壁南面与倒座北檐之间留出可通行走道：取 1.2 时走道仅 0.95m，0.5m 占据格下人体无可行区间（实测巡游擦碰），故取 2.0。"
      }
    },
    "note": "规制数值依据马炳坚《北京四合院建筑》、北京市《北京老城保护房屋修缮技术导则(2019)》、清工部《工程做法则例》小式、清《内务府奏销档》实测折算（modus=每间基准米数，jinshen=进深折合间数，taiming=台明高）。",
    "wall": {
      "height": 3.3,
      "thickness": 0.4,
      "outerThickness": 0.4,
      "desc": "院墙默认高3.3m、厚0.4m；外围围墙可略高(3.6m)"
    }
  },
  "wall": {
    "model": "boundarySegmentRealization",
    "base": "perCourtyardRing",
    "ref": "yuanqiang_gongqiang",
    "taxonomy": {
      "围墙": {
        "desc": "围合院落、不属任何单栋房屋；基线状态即完整院墙环（外圈外围院墙 + 各进内隔墙）。",
        "kinds": ["weiqiang", "kaziqiang", "buqiang", "youlang", "yingbi"]
      },
      "建筑用墙(非围墙)": {
        "desc": "围合房间、属房屋结构；其贴边界段（后檐墙）兼作院墙、分段替换基线围墙对应段。",
        "kinds": ["houyanqiang"]
      }
    },
    "desc": "无建筑时每院仅有完整院墙环（外圈外围院墙 + 各进内隔墙，纯围墙基线）；叠加建筑后，其贴边界的后檐墙分段实现（替换）对应围墙段。坐标零，由几何层实例化。",
    "kinds": {
      "weiqiang": {
        "ref": "weiqiang",
        "label": "外围围墙",
        "desc": "整座院落群最外圈连续围墙，高大不开窗；由各进院落外圈段拼合构成",
        "height": 3.6,
        "thickness": 0.4
      },
      "kaziqiang": {
        "ref": "kaziqiang",
        "label": "卡子墙",
        "desc": "院落间分隔墙，正中开垂花门",
        "height": 3.3,
        "thickness": 0.4
      },
      "houyanqiang": {
        "ref": "houyanqiang",
        "label": "后檐墙",
        "desc": "建筑自带、兼作院落边界的墙",
        "height": 3.3,
        "thickness": 0.3
      },
      "buqiang": {
        "ref": "buqiang",
        "label": "补墙",
        "desc": "建筑间空隙填补短墙",
        "height": 3.3,
        "thickness": 0.4
      },
      "youlang": {
        "ref": "youlang",
        "label": "游廊",
        "desc": "连接各屋带顶走廊（可选）"
      },
      "yingbi": {
        "ref": "yingbi",
        "label": "影壁",
        "desc": "入口遮挡短墙（可选）"
      }
    },
    "boundarySegment": {
      "ringBaseExists": true,
      "buildingRealizesSegment": true,
      "gapFill": [
        "buqiang",
        "youlang"
      ],
      "desc": "每院四侧先有墙基底（纯围墙基线）；provider=建筑时该侧由建筑后檐墙分段实现(替换，不另画独立墙)；provider=null时画独立院墙(yuanqiang)，与相邻建筑后檐墙共线；门(gate)在段上开缺"
    }
  }
}