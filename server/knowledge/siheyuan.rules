{
  "meta": {
    "type": "siheyuan",
    "desc": "北京四合院规则库（WHERE·约束）：方位/朝向/围合/对称/序列 + 规制默认值。实例图谱必须满足本库约束。",
    "dictRef": "dict.json",
    "typeRef": "siheyuan.type.json",
    "note": "⚠️ 规制数值为传统标准型占位参考，待用户（文化建设主场）校准真实古建数字"
  },
  "paramRanges": {
    "jin": { "ref": "jin", "range": [1, 4], "desc": "院落进数允许范围（已放宽至四进）" }
  },
  "orientation": [
    { "role": "zhengfang", "must": "zuobeichaonan", "ref": "zuobeichaonan", "desc": "正房坐北朝南" },
    { "role": "daozuofang", "faces": "bei", "ref": "bei", "desc": "倒座房朝北，与正房相对" },
    { "role": "xiangfang", "faces": ["dong", "xi"], "ref": ["dong", "xi"], "desc": "厢房东/西向，山墙朝外" }
  ],
  "position": [
    { "role": "zhengfang", "at": "zhongzhou_north", "constraint": "juzhong", "ref": ["zhongzhou", "juzhong"], "desc": "正房居中、位于中轴北端" },
    { "role": "xiangfang", "at": ["dong", "xi"], "constraint": "duichen", "ref": ["dong", "xi", "duichen"], "desc": "厢房东西对称" },
    { "role": "daozuofang", "at": "nan_end", "desc": "倒座房位于院落最南" },
    { "role": "chuihuamen", "between": "courtyards", "ref": "chuihuamen", "desc": "垂花门分隔相邻院落" },
    { "role": "houzhaofang", "at": "north_of_zhengfang", "ref": "houzhaofang", "desc": "后罩房位于正房之后" }
  ],
  "sequence": {
    "ref": "xulie",
    "desc": "进沿中轴南北序列；进数↑院落往南加",
    "byJin": {
      "1": ["正院(正房北 + 厢房东西 + 倒座房南 + 庭院)"],
      "2": ["外院", "chuihuamen", "内院"],
      "3": ["外院", "chuihuamen", "内院", "正院(含后罩房)"]
    }
  },
  "norms": {
    "modus": 3.3,
    "courtDepthRatio": 0.6,
    "layout": {
      "xiangfang": {
        "lengthMode": "miankuo",
        "aisle": 1.5,
        "zAlign": "center",
        "desc": "厢房沿庭院方向(Z)长度取自身面阔(3间×modus≈9.9m)，居中放置在正房与倒座之间的庭院区域，南北两端各留1.5m通道，使中央庭院完整保留（不填满庭院、不与正房/倒座紧贴）"
      }
    },
    "zhengfang": {
      "miankuo": 5,
      "ratio": { "mingjian": 10, "cijian": 8, "shaojian": 6 },
      "jinshen": 2,
      "desc": "正房面阔5间(1明+2次+2梢)；进深约6.5m(≈2×modus)，据《北京老城保护房屋修缮技术导则2019》正房五檩/七檩进深6.5~7m"
    },
    "xiangfang": { "miankuo": 3, "jinshen": 1.4, "desc": "厢房面阔3间；进深约4.5m(≈1.4×modus)，据导则厢房无廊进深4m、带廊5m" },
    "daozuofang": { "miankuo": 5, "jinshen": 1.4, "desc": "倒座房面阔约同正房；进深较浅约4.5m" },
    "houzhaofang": { "miankuo": 5, "jinshen": 1.5, "desc": "后罩房面阔约同正房；进深较浅约5m" },
    "note": "规制数值依据马炳坚《北京四合院建造》、北京市《北京老城保护房屋修缮技术导则(2019)》、清《内务府奏销档》实测折算（modus=每间基准米数，jinshen=进深折合间数）。"
  }
}
