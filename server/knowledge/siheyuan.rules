{
  "meta": {
    "type": "siheyuan",
    "desc": "北京四合院规则库（WHERE·约束）：方位/朝向/围合/对称/序列 + 规制默认值。实例图谱必须满足本库约束。",
    "dictRef": "dict.json",
    "typeRef": "siheyuan.type.json",
    "note": "⚠️ 规制数值为传统标准型占位参考，待用户（文化建设主场）校准真实古建数字"
  },
  "orientation": [
    { "role": "zhengfang", "must": "zuobeichaonan", "ref": "zuobeichaonan", "desc": "正房坐北朝南" },
    { "role": "daozuofang", "faces": "bei", "ref": "bei", "desc": "倒座房朝北，与正房相对" },
    { "role": "xiangfang", "faces": ["dong", "xi"], "ref": ["dong", "xi"], "desc": "厢房东/西向，山墙朝外" }
  ],
  "position": [
    { "role": "zhengfang", "at": "zhongzhou_north", "constraint": "juzhong", "ref": ["zhongzhou", "juzhong"], "desc": "正房居中、位于中轴北端" },
    { "role": "xiangfang", "at": ["dong", "xi"], "constraint": "duichen", "ref": ["dong", "xi", "duichen"], "desc": "厢房东西对称" },
    { "role": "daozuofang", "at": "nan_end", "desc": "倒座房位于院落最南" },
    { "role": "chuihuamen", "between": "courtyards", "cond": "jin>1", "ref": "chuihuamen", "desc": "垂花门分隔相邻院落（进数>1）" },
    { "role": "houzhaofang", "at": "north_of_zhengfang", "cond": "jin>=3", "ref": "houzhaofang", "desc": "后罩房位于正房之后（多进）" }
  ],
  "relation": [
    { "type": "weihe", "ref": "weihe", "desc": "房屋围合庭院" },
    { "type": "duichen", "ref": "duichen", "desc": "中轴两侧镜像" },
    { "type": "xulie", "ref": "xulie", "desc": "进沿中轴南北序列" },
    { "type": "juzhong", "ref": "juzhong", "desc": "主体居中" }
  ],
  "sequence": {
    "ref": "xulie",
    "desc": "进沿中轴南北序列；进数↑院落往南加",
    "byJin": {
      "1": ["正院(正房北 + 厢房东西 + 倒座房南 + 庭院)"],
      "2": ["外院", "chuihuamen", "内院"],
      "3": ["外院", "chuihuamen", "内院", "正院(含后罩房)"]
    }
  },
  "norms": {
    "zhengfang": {
      "miankuo": 5,
      "jianComposition": ["mingjian", "cijian", "cijian", "shaojian", "shaojian"],
      "ratio": { "mingjian": 10, "cijian": 8, "shaojian": 6 },
      "jinshen": 3,
      "desc": "正房面阔5间(1明+2次+2梢)；明间最宽，次间≈0.8明间，梢间递减"
    },
    "xiangfang": { "miankuo": 3, "jianComposition": ["mingjian", "cijian", "cijian"], "jinshen": 2, "desc": "厢房面阔3间" },
    "daozuofang": { "miankuo": 5, "jinshen": 2, "desc": "倒座房面阔约同正房" },
    "houzhaofang": { "miankuo": 5, "desc": "后罩房面阔约同正房" },
    "note": "⚠️ 占位标准型，待文化建设校准"
  }
}
