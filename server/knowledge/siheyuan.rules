{
  "meta": {
    "type": "siheyuan",
    "desc": "北京四合院规则库（WHERE·约束）：方位/朝向/围合/对称/序列 + 规制默认值。实例图谱必须满足本库约束。",
    "dictRef": "dict.json",
    "typeRef": "siheyuan.type.json",
    "note": "⚠️ 规制数值为传统标准型占位参考，待用户（文化建设主场）校准真实古建数字"
  },
  "paramRanges": {
    "jin": {
      "ref": "jin",
      "range": [
        1,
        4
      ],
      "desc": "院落进数允许范围（已放宽至四进）"
    }
  },
  "orientation": [
    {
      "role": "zhengfang",
      "must": "zuobeichaonan",
